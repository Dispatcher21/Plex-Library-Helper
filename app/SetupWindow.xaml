<Window x:Class="PlexLibraryHelper.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up Plex Library Helper" Width="860" Height="720" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <!-- left: logo and the steps -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="22,24,18,20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,28">
          <Image Source="{StaticResource Logo}" Width="30" Height="30"/>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Plex Library Helper" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Fg}"/>
            <TextBlock x:Name="VersionText" Text="Setup" FontSize="12" Foreground="{StaticResource Fg3}"/>
          </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="PcText" Style="{StaticResource Fine}"/>
        <StackPanel x:Name="StepList"/>
      </DockPanel>
    </Border>
    <!-- right: the current step, and the buttons -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="32,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="BackBtn" Content="Back" Style="{StaticResource Ghost}" Margin="0,0,8,0"/>
            <Button x:Name="NextBtn" Content="Next" Style="{StaticResource Primary}" MinWidth="110"/>
          </StackPanel>
          <TextBlock x:Name="FootText" Style="{StaticResource Fine}" VerticalAlignment="Center" Margin="0,0,16,0"/>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
        <ContentControl x:Name="Page" MaxWidth="640" HorizontalAlignment="Left" Margin="32,28,24,20"/>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
